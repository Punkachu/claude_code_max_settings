{
  "name": "max_settings",
  "version": "1.4.0",
  "description": "Auto-format files after Claude edits them: TS/JS (prettier), Go, Dart/Flutter, Python (ruff), C/C++ (clang-format), Kotlin (ktlint), Swift (swiftformat). Blocks Bash commands that read .env files. Blocks destructive commands (rm -rf /, force push, DROP TABLE, terraform destroy...).",
  "author": {
    "name": "Julien .L",
    "email": "thehiphacker@gmail.com"
  },
  "repository": "https://github.com/Punkachu/claude_code_max_settings",
  "license": "Apache-2.0",
  "keywords": [
    "formatter",
    "hooks",
    "prettier",
    "ruff",
    "dart",
    "clang-format",
    "ktlint",
    "swiftformat",
    "security",
    "dotenv",
    "guardrail"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/format-changed-file.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-env-access.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-dangerous-commands.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
