{
  "name": "max_settings",
  "version": "1.0.0",
  "description": "Auto-format files after Claude edits them: TS/JS (prettier), Go, Dart/Flutter, Python (ruff), C/C++ (clang-format), Kotlin (ktlint), Swift (swiftformat).",
  "author": {
    "name": "Julien .L",
    "email": "thehiphacker@gmail.com"
  },
  "repository": "https://github.com/Punkachu/claude_code_max_settings",
  "license": "Apache-2.0",
  "keywords": ["formatter", "hooks", "prettier", "ruff", "dart", "clang-format", "ktlint", "swiftformat"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/format-changed-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}